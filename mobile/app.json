{
  "expo": {
    "name": "驗屋預約管理",
    "slug": "servicehopo",
    "scheme": "inspectionadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "需要連線到區域網路上的本地主機以管理預約資料庫"
      },
      "bundleIdentifier": "com.servicehopo.inspection"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.servicehopo.inspection"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "驗屋預約管理",
      "shortName": "驗屋管理",
      "themeColor": "#1d4ed8",
      "backgroundColor": "#f3f4f6"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "驗屋時需要拍攝現場照片",
          "photosPermission": "驗屋時需要從相簿選擇現場照片"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "owner": "service.hopo",
    "extra": {
      "eas": {
        "projectId": "99895a26-beb0-4dbc-937a-7edd6a27639a"
      }
    }
  }
}
