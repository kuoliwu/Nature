# 複製成 .env 後修改
HOST=0.0.0.0
PORT=8000

# 預設使用 SQLite，檔案存在 backend/data/inspection.db
# 改用 PostgreSQL 時：DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/inspection
# DATABASE_URL=sqlite:///./data/inspection.db

# APP 呼叫 /init-db 時必須在 Header 帶 X-Admin-Key，請務必改成自己的隨機字串
ADMIN_INIT_KEY=hp80630389

# 身分證字號只存雜湊值，此為雜湊用的鹽值（上線後請勿再更改，否則舊資料無法比對）
ID_HASH_SALT=hp80630389

# --- 線上授權 / Email（步驟三）-------------------------------------------
# 固定的對外網址（屋主連結、受託人邀請信都會使用）。見 README 第 9 節
# PUBLIC_BASE_URL=https://sign.example.com

# 管理 APP 開放到外網（手機不需安裝 Tailscale）：run.py 會自動設定 Tailscale Funnel，
# 網址為 https://電腦名稱.xxx.ts.net:8443/app。只能用 443、8443、10000；設 0 = 只在區網 / Tailscale 使用
# ADMIN_FUNNEL_PORT=8443
# Cloudflare 具名通道 token；有填時 python run.py --tunnel 會使用固定網址
# CLOUDFLARE_TUNNEL_TOKEN=

# SMTP；SMTP_HOST 留空時不會真的寄信，信件存成 .eml 放在 storage/outbox/ 方便測試
# Gmail 範例：SMTP_HOST=smtp.gmail.com、SMTP_PORT=587、SMTP_PASSWORD 使用「應用程式密碼」
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 授權書字型（需支援繁體中文的 .ttf）；留空時自動尋找 backend/fonts/*.ttf 或 Windows 標楷體
# PDF_FONT_PATH=/mnt/c/Windows/Fonts/kaiu.ttf

# --- 每日排程（M5 / M6）-----------------------------------------------------
# 報告未完成提醒（預約日後 7 / 14 天）收件人，逗號分隔；空白時寄到 MAIL_FROM
# REMINDER_TO=service@example.com,manager@example.com
# REMINDER_HOUR=9
# 每日備份：建議設到另一顆硬碟或雲端同步資料夾（例如 OneDrive），保留天數預設 30
# BACKUP_DIR=/mnt/c/Users/b9211/OneDrive/驗屋系統備份
# BACKUP_HOUR=3
# BACKUP_KEEP_DAYS=30
